---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";
import { tools } from "../../lib/data";
import { langParams, useT } from "../../i18n";
import { BADGE_H, BADGE_W, badgeKindOf, badgeSnippets } from "../../lib/badge";
export function getStaticPaths() { return langParams().map((params) => ({ params })); }
const lang = Astro.params.lang ?? "en"; const { t, p } = useT(lang);
const ex = tools.find((x) => badgeKindOf(x) === "verified" && x.id === "alpaca-mcp") ?? tools.find((x) => badgeKindOf(x) === "verified")!;
const listed = tools.find((x) => badgeKindOf(x) === "listed");
const site = SITE.name;
const sn = badgeSnippets(ex.id, "verified");
---
<Base title={t("badges.title")} description={t("badges.desc", { site })} lang={lang}>
<div class="wrap page prose">
  <h1>{t("badges.h1", { site })}</h1>
  <p>{t("badges.p1")}</p>
  <p dir="ltr">
    <img src={`/badge/${ex.id}.svg`} alt={sn.label} width={BADGE_W} height={BADGE_H} />
    {" "}
    <img src={`/badge/${ex.id}-dark.svg`} alt={sn.label} width={BADGE_W} height={BADGE_H} />
  </p>
  {listed && (
    <p dir="ltr">
      <img src={`/badge/${listed.id}.svg`} alt="Listed on TradingAIHub" width={BADGE_W} height={BADGE_H} />
      {" "}
      <img src={`/badge/${listed.id}-dark.svg`} alt="Listed on TradingAIHub" width={BADGE_W} height={BADGE_H} />
    </p>
  )}
  <h2>{t("tool.badgeMarkdown")}</h2>
  <pre class="ltr" dir="ltr"><code dir="ltr">{`[![${sn.label}](${SITE.url}/badge/<your-tool-id>.svg)](${SITE.url}/tools/<your-tool-id>/?utm_source=badge)`}</code></pre>
  <h2>{t("tool.badgeHtml")}</h2>
  <pre class="ltr" dir="ltr"><code dir="ltr">{`<a href="${SITE.url}/tools/<your-tool-id>/?utm_source=badge"><img src="${SITE.url}/badge/<your-tool-id>.svg" alt="${sn.label}" width="${BADGE_W}" height="${BADGE_H}"></a>`}</code></pre>
  <p class="note ltr" dir="ltr">{t("tool.badgeDark", { src: `${SITE.url}/badge/<your-tool-id>-dark.svg` })}</p>
  <p>{t("badges.p2")} <a href={p("/submit/")}>{t("badges.submitFree")}</a>.</p>
  <h2>{t("badges.states")}</h2><p>{t("badges.statesP")}</p>
</div>
</Base>
